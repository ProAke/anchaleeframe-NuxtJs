# Copy to .env and replace all example secrets before using outside local development.
# The database password is shared with the MariaDB service in docker-compose.yml.
MARIADB_ROOT_PASSWORD=replace-with-a-long-root-password
NUXT_DATABASE_HOST=127.0.0.1
NUXT_DATABASE_PORT=3306
NUXT_DATABASE_NAME=anchalee_frame
NUXT_DATABASE_USER=anchalee_app
NUXT_DATABASE_PASSWORD=replace-with-a-long-database-password
NUXT_ADMIN_EMAIL=admin@anchaleeframe.com
NUXT_ADMIN_PASSWORD=replace-with-a-unique-admin-password
